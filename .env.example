# Authentication Secret Key (CHANGE THIS IN PRODUCTION!)
AUTH_SECRET_KEY=your-super-secret-key-change-me-in-production

# Gemini API Key (for AI chat features)
GEMINI_API_KEY=your-gemini-api-key-here

# Database URL (default: SQLite)
# For SQLite: sqlite:///./data/dari.db
# For PostgreSQL: postgresql://user:password@postgres:5432/dari_db
DATABASE_URL=sqlite:///./data/dari.db

# CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
